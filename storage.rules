rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "admin@motaz-ec8dc.com"
                   && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
